{
  "manifest_version": 3,
  "name": "Core",
  "description": "Analyze Gmail threads and create draft replies.",
  "version": "1.0.0",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
     "http://localhost:4001/*"
  ],
  "action": {
    "default_title": "Inbox Copilot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
