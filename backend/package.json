{
  "name": "core-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Core MVP",
  "main": "dist/server.js",
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$lines = netstat -aon | Select-String ':4001\\s+.*LISTENING'; foreach ($line in $lines) { $procId = ($line.ToString() -split '\\s+')[-1]; if ($procId) { Stop-Process -Id $procId -Force -ErrorAction SilentlyContinue } }; exit 0\"",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "openai": "^4.76.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
